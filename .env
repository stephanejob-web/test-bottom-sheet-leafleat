# API Base URL - Change this to your machine's IP address for physical devices
# Get your IP with: ipconfig getifaddr en0 (Mac) or ipconfig (Windows)
API_URL=http://192.168.0.62:3000

# Cache TTL in milliseconds (5 minutes)
CACHE_TTL=300000

# API timeout in milliseconds (10 seconds)
API_TIMEOUT=10000
